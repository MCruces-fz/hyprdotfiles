configuration {
	modes: "window,drun,run,ssh,filebrowser";
	show-icons: true;
	display-ssh: "󰣀 ssh";
	display-drun: "  drun";
	display-run: "  run";
	display-filebrowser: "  filebrowser";
	display-window: "  window";
  timeout {
      /*delay:  15;*/
      action: "kb-cancel";
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}

window {
	border-radius: 3px;
	border: 4px;
	border-color: #bd93f9;
}

