#!/usr/bin/env bash
# Script: prntclrs
# Uso: ./prntclrs archivo.conf
# Muestra los colores definidos en un archivo tipo Hyprland

file="$1"

if [[ -z "$file" || ! -f "$file" ]]; then
  echo "Uso: $0 archivo.conf"
  exit 1
fi

# Explicación:
# - Buscamos líneas tipo "$nombre = rgb(XXXXXX)" o "$nombre = XXXXXX"
# - Capturamos nombre y color
grep -E '^\$[A-Za-z0-9_-]+\s*=\s*(rgb\([0-9A-Fa-f]{6}\)|[0-9A-Fa-f]{6})' "$file" | while read -r line; do
  # Extraer nombre y valor
  name=$(echo "$line" | sed -E 's/^\$([A-Za-z0-9_-]+).*/\1/')
  color=$(echo "$line" | sed -E 's/.*=\s*(rgb\(([0-9A-Fa-f]{6})\)|([0-9A-Fa-f]{6})).*/\2\3/')

  # Convertir a mayúsculas y asegurar prefijo #
  color_upper=$(echo "$color" | tr '[:lower:]' '[:upper:]')
  hex="#${color_upper}"

  # Convertir HEX a RGB decimal (para secuencias ANSI)
  r=$((16#${color_upper:0:2}))
  g=$((16#${color_upper:2:2}))
  b=$((16#${color_upper:4:2}))

  # Texto coloreado (ANSI 24-bit)
  printf "\e[38;2;%d;%d;%dm$%-15s\e[0m %s\n" "$r" "$g" "$b" "\$$name" "$hex"
done
