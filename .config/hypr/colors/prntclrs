#!/usr/bin/env bash
# Script: prntclrs
# Uso: ./prntclrs archivo.conf
# Muestra los colores definidos en un archivo tipo Hyprland con bloques de color

file="$1"

if [[ -z "$file" || ! -f "$file" ]]; then
  echo "Uso: $0 archivo.conf"
  exit 1
fi

# Buscar líneas tipo "$nombre = rgb(XXXXXX)" o "$nombre = XXXXXX"
grep -E '^\$[A-Za-z0-9_-]+\s*=\s*(rgb\([0-9A-Fa-f]{6}\)|[0-9A-Fa-f]{6})' "$file" | while read -r line; do
  # Extraer nombre y color
  name=$(echo "$line" | sed -E 's/^\$([A-Za-z0-9_-]+).*/\1/')
  color=$(echo "$line" | sed -E 's/.*=\s*(rgb\(([0-9A-Fa-f]{6})\)|([0-9A-Fa-f]{6})).*/\2\3/')

  # Normalizar formato
  color_upper=$(echo "$color" | tr '[:lower:]' '[:upper:]')
  hex="#${color_upper}"

  # Convertir HEX a RGB decimal
  r=$((16#${color_upper:0:2}))
  g=$((16#${color_upper:2:2}))
  b=$((16#${color_upper:4:2}))

  # ANSI 24-bit para color de fondo
  bg="\e[48;2;${r};${g};${b}m"
  fg="\e[38;2;${r};${g};${b}m"
  reset="\e[0m"

  # Imprimir: nombre, hex, y bloque de color
  printf "%-15s %s %-2s %b        %b\n" "\$$name" "$hex" "" "$bg      $reset" ""
done
